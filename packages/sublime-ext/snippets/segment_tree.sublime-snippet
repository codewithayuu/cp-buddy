template<typename ${4:T}>
struct ${5:SegmentTree} {
    int n;
    vector<${4:T}> tree;
    
    ${5:SegmentTree}(int n) : n(n), tree(4 * n, 0) {}
    ${5:SegmentTree}(const vector<${4:T}>& a) {
        n = a.size();
        tree.assign(4 * n, 0);
        build(a, 1, 0, n - 1);
    }
    
    ${4:T} merge(${4:T} a, ${4:T} b) {
        return ${1:a + b}; // $1 Change merge operation here
    }
    
    void build(const vector<${4:T}>& a, int node, int l, int r) {
        if (l == r) {
            tree[node] = a[l];
            return;
        }
        int mid = l + (r - l) / 2;
        build(a, 2 * node, l, mid);
        build(a, 2 * node + 1, mid + 1, r);
        tree[node] = merge(tree[2 * node], tree[2 * node + 1]);
    }
    
    void update(int node, int l, int r, int idx, ${4:T} val) {
        if (l == r) {
            tree[node] = ${2:val}; // $2 Change update operation here
            return;
        }
        int mid = l + (r - l) / 2;
        if (idx <= mid) update(2 * node, l, mid, idx, val);
        else update(2 * node + 1, mid + 1, r, idx, val);
        tree[node] = merge(tree[2 * node], tree[2 * node + 1]);
    }
    
    ${4:T} query(int node, int l, int r, int ql, int qr) {
        if (ql > r || qr < l) return ${3:0}; // $3 Change identity value here
        if (ql <= l && r <= qr) return tree[node];
        int mid = l + (r - l) / 2;
        return merge(query(2 * node, l, mid, ql, qr), 
                     query(2 * node + 1, mid + 1, r, ql, qr));
    }
    
    void update(int idx, ${4:T} val) { update(1, 0, n - 1, idx, val); }
    ${4:T} query(int l, int r) { return query(1, 0, n - 1, l, r); }
};
