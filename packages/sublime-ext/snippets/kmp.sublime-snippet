// KMP Algorithm (Knuth-Morris-Pratt)
// Time Complexity: O(N + M)
vector<int> ${1:computeLPS}(const string& ${2:p}) {
    int m = ${2:p}.length();
    vector<int> lps(m, 0);
    int len = 0;
    for (int i = 1; i < m; ) {
        if (${2:p}[i] == ${2:p}[len]) {
            len++;
            lps[i] = len;
            i++;
        } else {
            if (len != 0) {
                len = lps[len - 1];
            } else {
                lps[i] = 0;
                i++;
            }
        }
    }
    return lps;
}

vector<int> ${3:kmpSearch}(const string& ${4:s}, const string& ${2:p}) {
    vector<int> res;
    int n = ${4:s}.length(), m = ${2:p}.length();
    if (m == 0) return res;
    vector<int> lps = ${1:computeLPS}(${2:p});
    int i = 0, j = 0;
    while (i < n) {
        if (${2:p}[j] == ${4:s}[i]) {
            i++; j++;
        }
        if (j == m) {
            res.push_back(i - j); // Match found at index (i - j)
            j = lps[j - 1];
        } else if (i < n && ${2:p}[j] != ${4:s}[i]) {
            if (j != 0) j = lps[j - 1];
            else i++;
        }
    }
    return res;
}
