// DP on Trees (Subtree size & Diameter) - O(N)
vector<int> ${1:sz}(${2:N} + 1, 0), ${3:down}(${2:N} + 1, 0);
int ${4:diameter} = 0;

void ${5:dfs}(int u, int p) {
    ${1:sz}[u] = 1;
    ${3:down}[u] = 0;
    int mx1 = 0, mx2 = 0;
    for (int v : ${6:adj}[u]) {
        if (v == p) continue;
        ${5:dfs}(v, u);
        ${1:sz}[u] += ${1:sz}[v];
        if (${3:down}[v] + 1 > mx1) {
            mx2 = mx1;
            mx1 = ${3:down}[v] + 1;
        } else if (${3:down}[v] + 1 > mx2) {
            mx2 = ${3:down}[v] + 1;
        }
    }
    ${3:down}[u] = mx1;
    ${4:diameter} = max(${4:diameter}, mx1 + mx2);
}
$0
