// Modular Exponentiation - O(log b)
${1:long long} binpow(${1:long long} a, ${1:long long} b, ${1:long long} m = ${2:MOD}) {
    a %= m;
    ${1:long long} res = 1;
    while (b > 0) {
        if (b & 1)
            res = res * a % m;
        a = a * a % m;
        b >>= 1;
    }
    return res;
}
$0
