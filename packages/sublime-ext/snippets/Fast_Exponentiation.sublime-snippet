long long binpow(long long a, long long b, long long mod = ${1:1e9+7}) {
    long long res = 1;
    a %= mod;
    while (b > 0) {
        if (b & 1)
            res = res * a % mod;
        a = a * a % mod;
        b >>= 1;
    }
    return res;
}
$0
