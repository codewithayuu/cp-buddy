template<typename ${1:T}>
struct ${2:LazySegmentTree} {
    int n;
    vector<${1:T}> tree, lazy;
    
    ${2:LazySegmentTree}(int n) : n(n), tree(4 * n, 0), lazy(4 * n, 0) {}
    ${2:LazySegmentTree}(const vector<${1:T}>& a) {
        n = a.size();
        tree.assign(4 * n, 0);
        lazy.assign(4 * n, 0);
        build(a, 1, 0, n - 1);
    }
    
    ${1:T} merge(${1:T} a, ${1:T} b) {
        return ${3:a + b};
    }
    
    void build(const vector<${1:T}>& a, int node, int l, int r) {
        if (l == r) {
            tree[node] = a[l];
            return;
        }
        int mid = l + (r - l) / 2;
        build(a, 2 * node, l, mid);
        build(a, 2 * node + 1, mid + 1, r);
        tree[node] = merge(tree[2 * node], tree[2 * node + 1]);
    }
    
    void push(int node, int l, int r) {
        if (lazy[node] != ${4:0}) {
            tree[node] += lazy[node] * ${5:(r - l + 1)};
            if (l != r) {
                lazy[2 * node] += lazy[node];
                lazy[2 * node + 1] += lazy[node];
            }
            lazy[node] = ${4:0};
        }
    }
    
    void update(int node, int l, int r, int ql, int qr, ${1:T} val) {
        push(node, l, r);
        if (ql > r || qr < l) return;
        if (ql <= l && r <= qr) {
            lazy[node] += val;
            push(node, l, r);
            return;
        }
        int mid = l + (r - l) / 2;
        update(2 * node, l, mid, ql, qr, val);
        update(2 * node + 1, mid + 1, r, ql, qr, val);
        tree[node] = merge(tree[2 * node], tree[2 * node + 1]);
    }
    
    ${1:T} query(int node, int l, int r, int ql, int qr) {
        push(node, l, r);
        if (ql > r || qr < l) return ${6:0};
        if (ql <= l && r <= qr) return tree[node];
        int mid = l + (r - l) / 2;
        return merge(query(2 * node, l, mid, ql, qr), 
                     query(2 * node + 1, mid + 1, r, ql, qr));
    }
    
    void update(int l, int r, ${1:T} val) { update(1, 0, n - 1, l, r, val); }
    ${1:T} query(int l, int r) { return query(1, 0, n - 1, l, r); }
};
