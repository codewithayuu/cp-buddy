// Extended Euclidean Algorithm
// Returns gcd(a, b) and sets x, y such that a*x + b*y = gcd(a, b)
// O(log min(a, b))
template<typename ${1:T}>
${1:T} ${2:extgcd}(${1:T} a, ${1:T} b, ${1:T} &x, ${1:T} &y) {
    if (b == 0) {
        x = 1;
        y = 0;
        return a;
    }
    ${1:T} x1, y1;
    ${1:T} d = ${2:extgcd}(b, a % b, x1, y1);
    x = y1;
    y = x1 - y1 * (a / b);
    return d;
}
