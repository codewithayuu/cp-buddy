// Smallest Prime Factor (SPF) via Sieve - O(N log log N) preprocessing
const int ${1:N} = ${2:MAXN};
vector<int> ${3:spf}(${1:N} + 1);
void ${4:sieve}() {
    for (int i = 1; i <= ${1:N}; i++) ${3:spf}[i] = i;
    for (int i = 2; i * i <= ${1:N}; i++) {
        if (${3:spf}[i] == i) {
            for (int j = i * i; j <= ${1:N}; j += i)
                if (${3:spf}[j] == j)
                    ${3:spf}[j] = i;
        }
    }
}
$0
