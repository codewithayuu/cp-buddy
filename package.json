{
  "name": "cpbuddy-monorepo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "compile": "pnpm --filter '*' run compile",
    "package": "tsx scripts/package.ts",
    "watch": "pnpm --filter '*' run watch",
    "test": "pnpm --filter '*' run test --reporter=verbose",
    "test:run": "pnpm --filter '*' run test:run",
    "typecheck": "tsc --build",
    "lint": "biome check",
    "format": "biome check --write",
    "clean": "rimraf packages/*/dist packages/*/out packages/*/scripts/out dist out scripts/out",
    "check-translations": "pnpm --filter '*' run check-translations",
    "bump": "tsx scripts/bump-version.ts",
    "prepare": "tsx scripts/install-hooks.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@swc/core": "^1.15.24",
    "@types/node": "~22.19.7",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/ui": "^4.1.4",
    "@vscode/vsce": "^3.7.1",
    "copy-webpack-plugin": "^14.0.0",
    "ignore": "^7.0.5",
    "knip": "^6.4.1",
    "rimraf": "^6.1.3",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.4.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "webpack": "^5.106.1",
    "webpack-cli": "^7.0.2"
  }
}
